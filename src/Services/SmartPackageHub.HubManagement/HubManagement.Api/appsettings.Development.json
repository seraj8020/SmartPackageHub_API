{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "Fast2Sms": {
        "Enabled": true,
        "ApiKey": "YOUR_FAST2SMS_TEST_API_KEY",
        "Route": "q",
        "SenderId": "SHPOTP",
        "MaxSendsPerSecond": 1
    },
  "WhatsAppFallback": {
    "Enabled": true,
    "WebhookUrl": ""
  },
  "SmsPumpingProtection": {
    "RestrictToIndia": true,
    "RecaptchaRequired": false
  },
  "FeatureFlags": {
    "CashOnDelivery": false
  }
}
