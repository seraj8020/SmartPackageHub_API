{
  "AllowedHosts": "*",
  "CorsOrigin": "https://qa-smartpackagehub.com",

  "ParcelPhotoStorage": {
    "Provider": "Gcs",
    "Bucket": "",
    "ObjectPrefix": "qa/"
  },
  "FeatureFlags": {
    "CashOnDelivery": true,
    "SmsOtp": false
  },
  "Auth": {
    "FixedLoginOtp": "123456"
  },
  "Fast2Sms": {
    "Enabled": false
  },
  "SmsPumpingProtection": {
    "RecaptchaRequired": false
  },
  "Email": {
    "Enabled": false
  },
  "swagger": {
    "enabled": true,
    "title": "Smart Package Hub API (QA)"
  },
  "Serilog": {
    "Properties": {
      "Environment": "QA"
    }
  }
}
