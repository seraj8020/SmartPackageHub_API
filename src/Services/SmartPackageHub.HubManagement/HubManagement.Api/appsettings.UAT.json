{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigin": "https://uat.smartpackagehub.com",
  "DbContextSettings": {
    "ConnectionString": "Host=postgres;Port=5432;Database=smartpackagehub_uat;Username=SpHubUatAdmin;Password=CHANGE_ME;Pooling=true;"
  },
  "RedisConnectionString": {
    "Redis": "redis:6379,password=CHANGE_ME"
  },
  "Fast2Sms": {
    "Enabled": true,
    "ApiKey": "",
    "Route": "q",
    "SenderId": "SHPOTP",
    "MaxSendsPerSecond": 1
  },
  "WhatsAppFallback": {
    "Enabled": false,
    "WebhookUrl": ""
  },
  "SmsPumpingProtection": {
    "RestrictToIndia": true,
    "RecaptchaRequired": true,
    "RecaptchaSecretKey": ""
  },
  "FeatureFlags": {
    "CashOnDelivery": true,
    "SmsOtp": true
  },
  "Auth": {
    "FixedLoginOtp": ""
  },
  "AnalyticsRollup": {
    "Enabled": true,
    "RunAfterHourUtc": 12,
    "RunAfterMinuteUtc": 30,
    "CheckIntervalMinutes": 5
  },
  "Email": {
    "Enabled": true,
    "FromAddress": "noreply@smartpackagehub.com",
    "FromDisplayName": "Smart Package Hub UAT"
  },
  "swagger": {
    "enabled": true,
    "title": "Smart Package Hub API (UAT)",
    "version": "v2"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Properties": {
      "Application": "SmartPackageHub.Api",
      "Environment": "UAT"
    }
  }
}
