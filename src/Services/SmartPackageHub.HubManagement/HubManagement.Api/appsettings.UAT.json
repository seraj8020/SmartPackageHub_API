{
  "CorsOrigin": "https://uat.smartpackagehub.com",
  "FeatureFlags": {
    "CashOnDelivery": true,
    "SmsOtp": true
  },
  "Auth": {
    "FixedLoginOtp": ""
  },
  "Fast2Sms": {
    "Enabled": true
  },
  "SmsPumpingProtection": {
    "RecaptchaRequired": true
  },
  "Email": {
    "Enabled": true,
    "FromAddress": "noreply@smartpackagehub.com",
    "FromDisplayName": "Smart Package Hub UAT"
  },
  "swagger": {
    "enabled": true,
    "title": "Smart Package Hub API (UAT)"
  },
  "Serilog": {
    "Properties": {
      "Environment": "UAT"
    }
  }
}
