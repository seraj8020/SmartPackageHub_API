# Domains come from docker-compose.proxy.yml environment (UI_DOMAIN / API_DOMAIN).
# Replace qa.localhost / qa-api.localhost with real DNS when available.
# Caddy will request Let's Encrypt certs automatically for public hostnames on :443.

{$UI_DOMAIN} {
	encode gzip
	reverse_proxy sph-ui:80
}

{$API_DOMAIN} {
	encode gzip
	reverse_proxy sph-api:8080
}
