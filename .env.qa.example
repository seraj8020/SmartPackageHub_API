# Copy to .env.qa on the VM / CI secrets store. Never commit .env.qa.
# Overrides appsettings.json + appsettings.QA.json via environment variables.
# Nested keys use double underscore: Section__Property

ASPNETCORE_ENVIRONMENT=QA
API_HOST_PORT=5000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

POSTGRES_DB=smartpackagehub_qa
POSTGRES_USER=SpHubQaAdmin
POSTGRES_PASSWORD=Admin@123

REDIS_PASSWORD=Admin@123

# Caddy edge (docker-compose.proxy.yml) — point DNS A/AAAA to the GCE VM
UI_DOMAIN=qa-smartpackagehub.com
API_DOMAIN=api.qa-smartpackagehub.com
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- API configuration overrides (highest priority when set) ---
DbContextSettings__ConnectionString=Host=postgres;Port=5432;Database=smartpackagehub_qa;Username=SpHubQaAdmin;Password=Admin@123;Pooling=true;
RedisConnectionString__Redis=redis:6379,password=Admin@123
CorsOrigin=https://qa-smartpackagehub.com


Fast2Sms__Enabled=false
Fast2Sms__ApiKey=

Email__Enabled=false
Email__HttpApiKey=
Email__SmtpPassword=

SmsPumpingProtection__RecaptchaRequired=false
SmsPumpingProtection__RecaptchaSecretKey=

Auth__FixedLoginOtp=123456
