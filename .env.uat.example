ASPNETCORE_ENVIRONMENT=UAT
API_HOST_PORT=5000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

POSTGRES_DB=smartpackagehub_uat
POSTGRES_USER=SpHubUatAdmin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

UI_DOMAIN=uat.localhost
API_DOMAIN=uat-api.localhost

DbContextSettings__ConnectionString=Host=postgres;Port=5432;Database=smartpackagehub_uat;Username=SpHubUatAdmin;Password=CHANGE_ME_STRONG_PASSWORD;Pooling=true;
RedisConnectionString__Redis=redis:6379,password=CHANGE_ME_REDIS_PASSWORD
