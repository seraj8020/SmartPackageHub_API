{
  "AllowedHosts": "smartpackagehub.com;*.smartpackagehub.com",
  "CorsOrigin": "https://app.smartpackagehub.com",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureFlags": {
    "CashOnDelivery": true,
    "SmsOtp": true
  },
  "Auth": {
    "FixedLoginOtp": ""
  },
  "Fast2Sms": {
    "Enabled": true
  },
  "SmsPumpingProtection": {
    "RecaptchaRequired": true
  },
  "Email": {
    "Enabled": true,
    "FromAddress": "noreply@smartpackagehub.com",
    "FromDisplayName": "Smart Package Hub"
  },
  "swagger": {
    "enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    },
    "Properties": {
      "Environment": "Production"
    }
  }
}
