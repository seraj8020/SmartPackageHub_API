{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigin": "http://localhost:5210",
    "DbContextSettings": {
        "ConnectionString": "Port=5432;Host=139.59.77.243;Database=PackageHubRevamp;User ID=SpHubAdmin;Password=Admin@123;Pooling=true;",
    },
  "RedisConnectionString": {
    "Redis": "localhost:6379"
  },
    "Fast2Sms": {
        "Enabled": true,
        "ApiKey": "YOUR_FAST2SMS_TEST_API_KEY",
        "BaseUrl": "https://www.fast2sms.com",
        "Route": "q",
        "SenderId": "SHPOTP",
        "DltMessageId": "",
        "MaxSendsPerSecond": 1
    },
  "WhatsAppFallback": {
    "Enabled": true,
    "WebhookUrl": ""
  },
  "SmsPumpingProtection": {
    "RestrictToIndia": true,
    "MaxRequestsPerIp": 5,
    "IpWindowMinutes": 15,
    "MaxRequestsPerPhone": 3,
    "PhoneWindowMinutes": 30,
    "RecaptchaRequired": false,
    "RecaptchaSecretKey": "",
    "RecaptchaMinScore": 0.5
  },
  "OutboundMessageQueue": {
    "RedisListKey": "sph:outbound-messages",
    "DequeuePollMilliseconds": 500
  },
  "FeatureFlags": {
    "CashOnDelivery": false,
    "SmsOtp": false
  },
  "Auth": {
    "FixedLoginOtp": "123456"
  },
  "Email": {
    "Enabled": false,
    "Transport": "both",
    "HttpProvider": "zeptomail",
    "HttpUrl": "",
    "HttpApiKey": "",
    "FromAddress": "noreply@smartpackagehub.local",
    "FromDisplayName": "Smart Package Hub",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseSsl": true
  },
  "swagger": {
    "enabled": true,
    "reDocEnabled": false,
    "name": "v2",
    "title": "Parcel Management Service",
    "version": "v2",
    "routePrefix": "",
    "includeSecurity": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ParcelManagementService"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://seq:5341/ingest/otlp/v1/traces",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf"
}
