{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "smartpackagehub.com;*.smartpackagehub.com",
  "CorsOrigin": "https://app.smartpackagehub.com",
  "DbContextSettings": {
    "ConnectionString": "Host=postgres;Port=5432;Database=smartpackagehub;Username=SpHubAdmin;Password=CHANGE_ME;Pooling=true;"
  },
  "RedisConnectionString": {
    "Redis": "redis:6379,password=CHANGE_ME"
  },
  "Fast2Sms": {
    "Enabled": true,
    "ApiKey": "",
    "Route": "q",
    "SenderId": "SHPOTP",
    "MaxSendsPerSecond": 1
  },
  "WhatsAppFallback": {
    "Enabled": true,
    "WebhookUrl": ""
  },
  "SmsPumpingProtection": {
    "RestrictToIndia": true,
    "RecaptchaRequired": true,
    "RecaptchaSecretKey": ""
  },
  "FeatureFlags": {
    "CashOnDelivery": true,
    "SmsOtp": true
  },
  "Auth": {
    "FixedLoginOtp": ""
  },
  "AnalyticsRollup": {
    "Enabled": true,
    "RunAfterHourUtc": 12,
    "RunAfterMinuteUtc": 30,
    "CheckIntervalMinutes": 5
  },
  "Email": {
    "Enabled": true,
    "FromAddress": "noreply@smartpackagehub.com",
    "FromDisplayName": "Smart Package Hub"
  },
  "swagger": {
    "enabled": false,
    "title": "Smart Package Hub API",
    "version": "v2"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Properties": {
      "Application": "SmartPackageHub.Api",
      "Environment": "Production"
    }
  }
}
