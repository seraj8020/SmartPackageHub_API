{
  "DbContextSettings": {
    "ConnectionString": "Host=postgres;Port=5432;Database=smartpackagehub_uat;Username=SpHubUatAdmin;Password=YOUR_UAT_DB_PASSWORD;Pooling=true;"
  },
  "RedisConnectionString": {
    "Redis": "redis:6379,password=YOUR_UAT_REDIS_PASSWORD"
  },
  "CorsOrigin": "https://uat.smartpackagehub.com",
  "Fast2Sms": {
    "Enabled": true,
    "ApiKey": "YOUR_FAST2SMS_API_KEY"
  },
  "Email": {
    "Enabled": true,
    "HttpApiKey": "YOUR_EMAIL_API_KEY",
    "SmtpUsername": "info@smartpackagehub.com",
    "SmtpPassword": "YOUR_SMTP_PASSWORD"
  },
  "SmsPumpingProtection": {
    "RecaptchaRequired": true,
    "RecaptchaSecretKey": "YOUR_RECAPTCHA_SECRET"
  },
  "Auth": {
    "FixedLoginOtp": ""
  }
}
