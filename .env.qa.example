# Copy to .env.qa on the VM (do not commit real secrets).
ASPNETCORE_ENVIRONMENT=QA
API_HOST_PORT=5000

POSTGRES_DB=smartpackagehub_qa
POSTGRES_USER=SpHubQaAdmin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Must match keys the API reads (see Program.cs / HostDiExtensions).
DbContextSettings__ConnectionString=Host=postgres;Port=5432;Database=smartpackagehub_qa;Username=SpHubQaAdmin;Password=CHANGE_ME_STRONG_PASSWORD;Pooling=true;
RedisConnectionString__Redis=redis:6379,password=CHANGE_ME_REDIS_PASSWORD

CorsOrigin=https://qa.smartpackagehub.com
