{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigin": "https://qa.smartpackagehub.com",
  "DbContextSettings": {
    "ConnectionString": "Host=postgres;Port=5432;Database=smartpackagehub_qa;Username=SpHubQaAdmin;Password=CHANGE_ME;Pooling=true;"
  },
  "RedisConnectionString": {
    "Redis": "redis:6379,password=CHANGE_ME"
  },
  "Fast2Sms": {
    "Enabled": false,
    "ApiKey": "",
    "Route": "q",
    "SenderId": "SHPOTP",
    "MaxSendsPerSecond": 1
  },
  "WhatsAppFallback": {
    "Enabled": false,
    "WebhookUrl": ""
  },
  "SmsPumpingProtection": {
    "RestrictToIndia": true,
    "RecaptchaRequired": false
  },
  "FeatureFlags": {
    "CashOnDelivery": true,
    "SmsOtp": false
  },
  "Auth": {
    "FixedLoginOtp": "123456"
  },
  "AnalyticsRollup": {
    "Enabled": true,
    "RunAfterHourUtc": 12,
    "RunAfterMinuteUtc": 30,
    "CheckIntervalMinutes": 5
  },
  "Email": {
    "Enabled": false
  },
  "swagger": {
    "enabled": true,
    "title": "Smart Package Hub API (QA)",
    "version": "v2"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Properties": {
      "Application": "SmartPackageHub.Api",
      "Environment": "QA"
    }
  }
}
