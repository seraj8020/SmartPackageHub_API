{
  "DbContextSettings": {
    "ConnectionString": "Host=postgres;Port=5432;Database=smartpackagehub;Username=SpHubAdmin;Password=YOUR_PROD_DB_PASSWORD;Pooling=true;"
  },
  "RedisConnectionString": {
    "Redis": "redis:6379,password=YOUR_PROD_REDIS_PASSWORD"
  },
  "CorsOrigin": "https://app.smartpackagehub.com",
  "Fast2Sms": {
    "Enabled": true,
    "ApiKey": "YOUR_FAST2SMS_API_KEY",
    "DltMessageId": "YOUR_DLT_ID"
  },
  "Email": {
    "Enabled": true,
    "HttpApiKey": "YOUR_EMAIL_API_KEY",
    "SmtpUsername": "noreply@smartpackagehub.com",
    "SmtpPassword": "YOUR_SMTP_PASSWORD"
  },
  "SmsPumpingProtection": {
    "RecaptchaRequired": true,
    "RecaptchaSecretKey": "YOUR_RECAPTCHA_SECRET"
  },
  "Auth": {
    "FixedLoginOtp": ""
  }
}
